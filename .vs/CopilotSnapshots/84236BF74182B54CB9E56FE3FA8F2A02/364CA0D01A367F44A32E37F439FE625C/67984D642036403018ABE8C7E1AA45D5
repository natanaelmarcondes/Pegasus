        private static bool MFcn_TabelaAtendeFiltroModulo(WMTbl_Tabela tabela, IReadOnlyCollection<string> modulosSelecionados)
        {
            if (modulosSelecionados.Count == 0)
            {
                return false;
            }

            if (tabela.Metadata is null || string.IsNullOrWhiteSpace(tabela.Metadata.Modulo))
            {
                return false;
            }

            var modulosTabela = tabela.Metadata.Modulo
                .Split([' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(DLLKEY_SiglaModulo)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .ToArray();

            return modulosTabela.Any(x => modulosSelecionados.Contains(x, StringComparer.OrdinalIgnoreCase));
        }

        private bool MFcn_TabelaPassaFiltrosIgnorar(WMTbl_Tabela tabela)
        {
            var nome = tabela.NomeFisico;
            var nomeLower = nome.ToLowerInvariant();
            var totalRegistros = tabela.RegistrosA + tabela.RegistrosB;

            if (chkIgnorarVazias.Checked && totalRegistros <= 0)
            {
                return false;
            }

            if (chkIgnorarLog.Checked && nomeLower.Contains("log", StringComparison.Ordinal))
            {
                return false;
            }

            if (chkIgnorarCep.Checked && nome.Equals("cep", StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            if (chkIgnorarTemp.Checked && MFcn_NomeContemQualquer(nomeLower, "temp", "tmp", "temporaria"))
            {
                return false;
            }

            if (chkIgnorarBackup.Checked && MFcn_NomeContemQualquer(nomeLower, "bkp", "bckup", "backup", "bk"))
            {
                return false;
            }

            return true;
        }

        private static bool MFcn_NomeContemQualquer(string nomeLower, params string[] termos)
        {
            foreach (var termo in termos)
            {
                if (nomeLower.Contains(termo, StringComparison.Ordinal))
                {
                    return true;
                }
            }

            return false;
        }

        private static string DLLKEY_SiglaModulo(string? valor)
        {
            if (string.IsNullOrWhiteSpace(valor))
            {
                return string.Empty;
            }

            var texto = valor.Trim().ToUpperInvariant();

            var abre = texto.LastIndexOf('(');
            var fecha = texto.LastIndexOf(')');
            if (abre >= 0 && fecha > abre)
            {
                var interno = texto.Substring(abre + 1, fecha - abre - 1).Trim();
                if (!string.IsNullOrWhiteSpace(interno))
                {
                    return interno;
                }
            }

            if (texto == "GERAL")
            {
                return "ALL";
            }

            return texto;
        }

        private bool MFcn_TentarObterFiltroPeriodo(out PeriodoFiltro filtro)
        {
            filtro = new PeriodoFiltro(0, 0, 0, 0, false);

            var periodoInicialTexto = txt_PeriodoInicial.Text.Trim();
            var periodoFinalTexto = txt_PeriodoFinal.Text.Trim();

            if (string.IsNullOrWhiteSpace(periodoInicialTexto) && string.IsNullOrWhiteSpace(periodoFinalTexto))
            {
                return true;
            }

            if (string.IsNullOrWhiteSpace(periodoInicialTexto) || string.IsNullOrWhiteSpace(periodoFinalTexto))
            {
                MessageBox.Show("Informe Período inicial e final no formato MM/YYYY.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            if (!DateTime.TryParseExact(periodoInicialTexto, "MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var dtInicial)
                || !DateTime.TryParseExact(periodoFinalTexto, "MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var dtFinal))
            {
                MessageBox.Show("Período inválido. Use MM/YYYY.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            if (dtInicial > dtFinal)
            {
                MessageBox.Show("Período inicial não pode ser maior que o final.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            var anoInicial = dtInicial.Year;
            var anoFinal = dtFinal.Year;
            var anoMesInicial = (dtInicial.Year * 100) + dtInicial.Month;
            var anoMesFinal = (dtFinal.Year * 100) + dtFinal.Month;

            filtro = new PeriodoFiltro(anoInicial, anoFinal, anoMesInicial, anoMesFinal, true);
            return true;
        }

        private static bool MFcn_TabelaDentroPeriodo(string nomeTabela, PeriodoFiltro filtro)
        {
            if (!filtro.Ativo)
            {
                return true;
            }

            var matchMensal = Regex.Match(nomeTabela, @"_(\d{6})$", RegexOptions.CultureInvariant);
            if (matchMensal.Success)
            {
                var anoMesTexto = matchMensal.Groups[1].Value;
                if (!int.TryParse(anoMesTexto, NumberStyles.None, CultureInfo.InvariantCulture, out var anoMes))
                {
                    return true;
                }

                var mes = anoMes % 100;
                if (mes < 1 || mes > 12)
                {
                    return true;
                }

                return anoMes >= filtro.AnoMesInicial && anoMes <= filtro.AnoMesFinal;
            }

            var matchAnual = Regex.Match(nomeTabela, @"_(\d{4})$", RegexOptions.CultureInvariant);
            if (matchAnual.Success)
            {
                if (!int.TryParse(matchAnual.Groups[1].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var ano))
                {
                    return true;
                }

                return ano >= filtro.AnoInicial && ano <= filtro.AnoFinal;
            }

            return true;
        }

        private KeyTabelaMetadata? MFcn_LocalizarMetadataTabela(string nomeTabelaFisica)
        {
            if (_wmMetadataKeyTabelas.TryGetValue(nomeTabelaFisica, out var metadataExata))
            {
                return metadataExata;
            }

            var nomeBase = MFcn_NomeTabelaBase(nomeTabelaFisica);
            if (!nomeBase.Equals(nomeTabelaFisica, StringComparison.OrdinalIgnoreCase)
                && _wmMetadataKeyTabelas.TryGetValue(nomeBase, out var metadataBase))
            {
                return metadataBase;
            }

            return null;
        }

        private async Task MPrc_CarregarMetadadosKeyTabelas(DbTarget targetA, DbTarget targetB)
        {
            _wmMetadataKeyTabelas.Clear();
            await MPrc_CarregarMetadadosKeyTabelasPorBanco(targetA);
            await MPrc_CarregarMetadadosKeyTabelasPorBanco(targetB);
        }

        private async Task MPrc_CarregarMetadadosKeyTabelasPorBanco(DbTarget target)
        {
            const string sql = @"
SELECT ktb_NomeFs, ktb_NomeLg, ktb_Modulo, ktb_TipoTb
FROM KEY_TABELAS;";

            try
            {
                await using var connection = new MySqlConnection(BuildConnectionString(target));
                await connection.OpenAsync();

                await using var command = new MySqlCommand(sql, connection);
                await using var reader = await command.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    var nomeFs = reader.IsDBNull(0) ? string.Empty : reader.GetString(0).Trim();
                    if (string.IsNullOrWhiteSpace(nomeFs))
                    {
                        continue;
                    }

                    if (_wmMetadataKeyTabelas.ContainsKey(nomeFs))
                    {
                        continue;
                    }

                    var nomeLg = reader.IsDBNull(1) ? string.Empty : reader.GetString(1).Trim();
                    var modulo = reader.IsDBNull(2) ? string.Empty : reader.GetString(2).Trim();
                    var tipoTb = reader.IsDBNull(3) ? string.Empty : reader.GetString(3).Trim();
                    _wmMetadataKeyTabelas[nomeFs] = new KeyTabelaMetadata(nomeFs, nomeLg, modulo, tipoTb);
                }
            }
            catch (Exception ex)
            {
                Log($"Aviso KEY_TABELAS ({target.Alias}): {ex.Message}");
            }
        }

        private void AddStatus(string alias, string table, string status, long rowCount)
        {
            var chave = $"{alias}|{table}";
            var qtd = MFcn_FormatarQuantidade(rowCount);
            var emExecucao = MFcn_StatusEmExecucao(status);

            if (_wmStatusRowByChave.TryGetValue(chave, out var rowIndex)
                && rowIndex >= 0
                && rowIndex < dgvStatus.Rows.Count)
            {
                var row = dgvStatus.Rows[rowIndex];
                row.Cells[colStatusTabela.Index].Value = table;
                row.Cells[colStatusEtapa.Index].Value = status;
                row.Cells[colStatusRegistros.Index].Value = qtd;
                row.Tag = chave;

                if (emExecucao && rowIndex != 0)
                {
                    dgvStatus.Rows.RemoveAt(rowIndex);
                    dgvStatus.Rows.Insert(0, table, status, qtd);
                    dgvStatus.Rows[0].Tag = chave;
                }

                MPrc_ReconstruirMapaStatus();
                if (dgvStatus.Rows.Count > 0)
                {
                    dgvStatus.InvalidateRow(0);
                }
                return;
            }

            if (emExecucao)
            {
                dgvStatus.Rows.Insert(0, table, status, qtd);
                dgvStatus.Rows[0].Tag = chave;
            }
            else
            {
                var novoIndex = dgvStatus.Rows.Add(table, status, qtd);
                dgvStatus.Rows[novoIndex].Tag = chave;
            }

            MPrc_ReconstruirMapaStatus();
        }

        private static string MFcn_FormatarQuantidade(long valor)
        {
            return valor.ToString("N0", CultureInfo.GetCultureInfo("pt-BR"));
        }

        private static long MFcn_ConverterTextoQuantidade(string? texto)
        {
            if (string.IsNullOrWhiteSpace(texto))
            {
                return 0;
            }

            var normalizado = texto.Trim().Replace(".", string.Empty, StringComparison.Ordinal).Replace(",", string.Empty, StringComparison.Ordinal);
            return long.TryParse(normalizado, NumberStyles.Integer, CultureInfo.InvariantCulture, out var valor)
                ? valor
                : 0;
        }

        private void dgvTablesA_SortCompare(object? sender, DataGridViewSortCompareEventArgs e)
        {
