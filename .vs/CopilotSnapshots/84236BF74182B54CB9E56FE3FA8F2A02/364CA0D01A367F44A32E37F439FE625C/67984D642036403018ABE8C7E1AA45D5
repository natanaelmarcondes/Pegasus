        private void UpdateProgress(int processed, int total)
        {
            progressMain.Maximum = Math.Max(1, total);
            progressMain.Value = Math.Min(processed, progressMain.Maximum);
            var pct = total == 0 ? 0 : (int)Math.Round((double)processed / total * 100, MidpointRounding.AwayFromZero);
            lblProgress.Text = $"Progresso: {processed} de {total} ({pct}%)";
        }

        private void dgvStatus_CellPainting(object sender, DataGridViewCellPaintingEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex != colStatusEtapa.Index)
            {
                return;
            }

            e.PaintBackground(e.CellBounds, true);

            var status = Convert.ToString(dgvStatus.Rows[e.RowIndex].Cells[colStatusEtapa.Index].Value) ?? string.Empty;
            var color = status switch
            {
                "Processando" or "Restaurando" => Color.Orange,
                "Concluído" => Color.LimeGreen,
                "Erro" => Color.Red,
                _ => Color.LightGray,
            };

            var size = Math.Min(e.CellBounds.Height - 8, 12);
            var rect = new Rectangle(
                e.CellBounds.X + 6,
                e.CellBounds.Y + (e.CellBounds.Height - size) / 2,
                size,
                size);

            using var brush = new SolidBrush(color);
            e.Graphics.FillEllipse(brush, rect);
            e.Graphics.DrawEllipse(Pens.DimGray, rect);

            var textRect = new Rectangle(
                rect.Right + 6,
                e.CellBounds.Y,
                e.CellBounds.Width - (rect.Width + 12),
                e.CellBounds.Height);

            TextRenderer.DrawText(
                e.Graphics,
                status,
                e.CellStyle.Font,
                textRect,
                e.CellStyle.ForeColor,
                TextFormatFlags.Left | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis);

            e.Paint(e.CellBounds, DataGridViewPaintParts.Border);
            e.Handled = true;
        }

        private async void btnLoadTables_Click(object sender, EventArgs e)
        {
            if (!TryGetTargets(out var targetA, out var targetB))
            {
                return;
            }

            if (!MFcn_TentarObterFiltroPeriodo(out var filtroPeriodo))
            {
                return;
            }

            try
            {
                SetBusy(true);
                MPrc_LimparStatusOperacional();
                if (MFcn_OperacaoAtual() == OperacaoModo.Restore)
                {
                    Log("Carregando tabelas da pasta de backup...");
                    await MPrc_CarregarTabelasRestoreAsync(targetA!, targetB!, filtroPeriodo);
                }
                else
                {
                    Log("Carregando tabelas físicas e metadados da KEY_TABELAS...");
                    await MPrc_CarregarTabelasBancoAsync(targetA!, targetB!, filtroPeriodo);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Falha ao carregar tabelas: {ex.Message}", "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
                Log($"Erro: {ex.Message}");
            }
            finally
            {
                SetBusy(false);
            }
        }

        private async Task<List<WMTbl_Tabela>> MPrc_CarregarTabelasLogicasAsync(DbTarget targetA, DbTarget targetB)
        {
            await MPrc_CarregarMetadadosKeyTabelas(targetA, targetB);

            var taskA = LoadTablesAsync(targetA);
            var taskB = LoadTablesAsync(targetB);
            await Task.WhenAll(taskA, taskB);

            var mapa = new Dictionary<string, WMTbl_Tabela>(StringComparer.OrdinalIgnoreCase);

            foreach (var table in taskA.Result)
            {
                if (!mapa.TryGetValue(table.Name, out var tabelaLogica))
                {
                    tabelaLogica = new WMTbl_Tabela
                    {
                        NomeFisico = table.Name,
                        Metadata = MFcn_LocalizarMetadataTabela(table.Name),
                    };
                    mapa[table.Name] = tabelaLogica;
                }

                tabelaLogica.ExisteA = true;
                tabelaLogica.RegistrosA = table.RowCount;
            }

            foreach (var table in taskB.Result)
            {
                if (!mapa.TryGetValue(table.Name, out var tabelaLogica))
                {
                    tabelaLogica = new WMTbl_Tabela
                    {
                        NomeFisico = table.Name,
                        Metadata = MFcn_LocalizarMetadataTabela(table.Name),
                    };
                    mapa[table.Name] = tabelaLogica;
                }

                tabelaLogica.ExisteB = true;
                tabelaLogica.RegistrosB = table.RowCount;
            }

            return mapa.Values
                .OrderBy(x => x.NomeFisico, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        private async Task MPrc_CarregarTabelasBancoAsync(DbTarget targetA, DbTarget targetB, PeriodoFiltro filtroPeriodo)
        {
            var tabelasLogicas = await MPrc_CarregarTabelasLogicasAsync(targetA, targetB);
            WMTbl_Tabelas.Clear();
            WMTbl_Tabelas.AddRange(tabelasLogicas);

            var tabelasFiltradas = WMTbl_Tabelas
                .Where(MFcn_TabelaPassaFiltrosIgnorar)
                .Where(x => MFcn_TabelaDentroPeriodo(x.NomeFisico, filtroPeriodo))
                .ToList();

            MPrc_PreencherGridModulos(tabelasFiltradas);
            MPrc_PreencherGridTabelasLogicas(tabelasFiltradas);
            MPrc_AplicarSelecaoAutomaticaPorModulo();
            Log($"Tabelas lógicas carregadas: {tabelasFiltradas.Count} (total descobertas: {WMTbl_Tabelas.Count})");
        }

        private async Task MPrc_CarregarTabelasRestoreAsync(DbTarget targetA, DbTarget targetB, PeriodoFiltro filtroPeriodo)
        {
            if (string.IsNullOrWhiteSpace(txtBackupBasePath.Text) || !Directory.Exists(txtBackupBasePath.Text))
            {
                MessageBox.Show("Informe uma pasta de backup válida.", "Restore", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            await MPrc_CarregarMetadadosKeyTabelas(targetA, targetB);

            var sqlFiles = Directory.GetFiles(txtBackupBasePath.Text, "*.sql", SearchOption.TopDirectoryOnly);
            var restoreMap = new Dictionary<string, WMTbl_Tabela>(StringComparer.OrdinalIgnoreCase);

            foreach (var file in sqlFiles)
            {
                var parsed = MFcn_ExtrairBancoETabelaDeArquivoRestore(file);
                if (parsed is null)
                {
                    continue;
                }

                if (!restoreMap.TryGetValue(parsed.Value.table, out var tabela))
                {
                    tabela = new WMTbl_Tabela
                    {
                        NomeFisico = parsed.Value.table,
                        Metadata = MFcn_LocalizarMetadataTabela(parsed.Value.table),
                    };
                    restoreMap[parsed.Value.table] = tabela;
                }

                if (parsed.Value.alias == "A")
                {
                    tabela.ExisteA = true;
                    tabela.ArquivoA = file;
                }
                else
                {
                    tabela.ExisteB = true;
                    tabela.ArquivoB = file;
                }
            }

            WMTbl_Tabelas.Clear();
            WMTbl_Tabelas.AddRange(
                restoreMap.Values
                    .Where(x => MFcn_TabelaPassaFiltrosIgnorar(x))
                    .Where(x => MFcn_TabelaDentroPeriodo(x.NomeFisico, filtroPeriodo))
                    .OrderBy(x => x.NomeFisico, StringComparer.OrdinalIgnoreCase));

            MPrc_PreencherGridModulos(WMTbl_Tabelas);
            MPrc_PreencherGridTabelasLogicas(WMTbl_Tabelas);
            MPrc_AplicarSelecaoAutomaticaPorModulo();
            Log($"Tabelas para restore carregadas: {WMTbl_Tabelas.Count}");
        }

        private void MPrc_PreencherGridTabelasLogicas(IReadOnlyCollection<WMTbl_Tabela> tabelas)
        {
            dgvTablesA.Rows.Clear();

            foreach (var tabela in tabelas)
            {
                var idx = dgvTablesA.Rows.Add();
                var row = dgvTablesA.Rows[idx];
                row.Cells["colSelA"].Value = true;
                row.Cells["colTabelaA"].Value = tabela.NomeFisico;
                row.Cells["colQtdA"].Value = MFcn_FormatarQuantidade(tabela.RegistrosA + tabela.RegistrosB);
                row.Tag = tabela;
            }

            lblTablesA.Text = "Tabelas";
        }

        private async void btnBackup_Click(object sender, EventArgs e)
        {
            if (_backupEmExecucao)
            {
                return;
            }

            if (!TryGetTargets(out var targetA, out var targetB))
            {
                return;
            }

            var selecionadas = MFcn_ObterTabelasSelecionadas();
            var totalTables = selecionadas.Sum(x => (x.ExisteA ? 1 : 0) + (x.ExisteB ? 1 : 0));

            if (totalTables == 0)
            {
                MessageBox.Show("Selecione ao menos uma tabela para backup.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(txtBackupBasePath.Text))
            {
                MessageBox.Show("Informe a pasta de backup.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                SetBusy(true);
                MPrc_ConfigurarModoBackup(true);
                MPrc_LimparStatusOperacional();
                UpdateProgress(0, totalTables);
                _backupCancellation = new CancellationTokenSource();
                _pularTabelaSolicitado = false;
                _chaveTabelaEmProcessamento = string.Empty;

                var backupDirectory = BuildBackupDirectory();
                Directory.CreateDirectory(backupDirectory);

                var processed = 0;
                processed = await BackupTablesAsync(targetA!, targetB!, selecionadas, backupDirectory, processed, totalTables, _backupCancellation.Token);

                UpdateProgress(processed, totalTables);
                MessageBox.Show("Backup concluído.", "Sucesso", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (OperationCanceledException)
            {
                Log("Backup cancelado pelo usuário.");
                MessageBox.Show("Backup cancelado.", "Informação", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Falha no backup: {ex.Message}", "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
                Log($"Erro no backup: {ex.Message}");
            }
            finally
            {
                _backupCancellation?.Dispose();
                _backupCancellation = null;
                _pularTabelaSolicitado = false;
                _chaveTabelaEmProcessamento = string.Empty;
                SetBusy(false);
                MPrc_ConfigurarModoBackup(false);
            }
        }

        private void btnRestore_Click(object sender, EventArgs e)
        {
            if (!_backupEmExecucao || _backupCancellation is null)
            {
                return;
            }

            _backupCancellation.Cancel();
            Log("Solicitado cancelamento do backup.");
        }

        private async Task<List<TableInfo>> LoadTablesAsync(DbTarget target)
        {
            const string query = @"
SELECT TABLE_NAME, COALESCE(TABLE_ROWS, 0) AS TABLE_ROWS
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = @db
  AND TABLE_TYPE = 'BASE TABLE'
ORDER BY TABLE_NAME;";

            var tables = new List<TableInfo>();

            await using var connection = new MySqlConnection(BuildConnectionString(target));
            await connection.OpenAsync();

            await using var command = new MySqlCommand(query, connection);
            command.Parameters.AddWithValue("@db", target.Database);

            await using var reader = await command.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                var name = reader.GetString(0);
                var rows = Convert.ToInt64(reader.GetValue(1), CultureInfo.InvariantCulture);
                tables.Add(new TableInfo(name, rows));
            }

            return tables;
        }

        private async Task<int> BackupTablesAsync(DbTarget targetA, DbTarget targetB, IReadOnlyCollection<WMTbl_Tabela> tabelas, string backupDirectory, int processed, int total, CancellationToken cancellationToken)
        {
            await using var connectionA = new MySqlConnection(BuildConnectionString(targetA));
            await using var connectionB = new MySqlConnection(BuildConnectionString(targetB));
            await connectionA.OpenAsync(cancellationToken);
            await connectionB.OpenAsync(cancellationToken);

            var sequencia = 1;

            foreach (var tabela in tabelas)
            {
                if (tabela.ExisteA)
                {
                    processed = await MPrc_ProcessarBackupTabelaAsync(targetA, connectionA, tabela, tabela.RegistrosA, "A", backupDirectory, sequencia, processed, total, cancellationToken);
                    sequencia++;
                }

                if (tabela.ExisteB)
                {
                    processed = await MPrc_ProcessarBackupTabelaAsync(targetB, connectionB, tabela, tabela.RegistrosB, "B", backupDirectory, sequencia, processed, total, cancellationToken);
                    sequencia++;
                }
            }

            return processed;
        }

        private async Task<int> MPrc_ProcessarBackupTabelaAsync(
            DbTarget target,
            MySqlConnection connection,
            WMTbl_Tabela tabela,
            long rowCount,
            string aliasArquivo,
            string backupDirectory,
            int sequencia,
            int processed,
            int total,
            CancellationToken cancellationToken)
        {
            var chaveTabela = $"{target.Alias}|{tabela.NomeFisico}";
            _chaveTabelaEmProcessamento = chaveTabela;
            _pularTabelaSolicitado = false;

            try
            {
                cancellationToken.ThrowIfCancellationRequested();

                AddStatus(target.Alias, tabela.NomeFisico, "Processando", rowCount);
                var sql = await GetTableBackupSqlAsync(connection, tabela.NomeFisico, cancellationToken);

                if (MFcn_DevePularTabelaAtual(chaveTabela))
                {
                    AddStatus(target.Alias, tabela.NomeFisico, "Pulada", rowCount);
                    processed++;
                    UpdateProgress(processed, total);
                    return processed;
                }

                var arquivo = MFcn_MontarNomeArquivoBackup(sequencia, aliasArquivo, tabela.NomeFisico);
                var caminhoArquivo = Path.Combine(backupDirectory, arquivo);
                await File.WriteAllTextAsync(caminhoArquivo, sql, Encoding.UTF8, cancellationToken);

                if (MFcn_DevePularTabelaAtual(chaveTabela))
                {
                    if (File.Exists(caminhoArquivo))
                    {
                        File.Delete(caminhoArquivo);
                    }

                    AddStatus(target.Alias, tabela.NomeFisico, "Pulada", rowCount);
                    processed++;
                    UpdateProgress(processed, total);
                    return processed;
                }

                if (target.Alias == "A")
                {
                    tabela.ArquivoA = caminhoArquivo;
                }
                else
                {
                    tabela.ArquivoB = caminhoArquivo;
                }

                AddStatus(target.Alias, tabela.NomeFisico, "Concluído", rowCount);
                processed++;
                UpdateProgress(processed, total);
                return processed;
            }
            catch (OperationCanceledException)
            {
                AddStatus(target.Alias, tabela.NomeFisico, "Cancelado", rowCount);
                throw;
            }
            catch
            {
                AddStatus(target.Alias, tabela.NomeFisico, "Erro", rowCount);
                throw;
            }
            finally
            {
                _chaveTabelaEmProcessamento = string.Empty;
                _pularTabelaSolicitado = false;
            }
        }

        private bool MFcn_DevePularTabelaAtual(string chaveTabela)
        {
            return _pularTabelaSolicitado
                && _backupEmExecucao
                && string.Equals(_chaveTabelaEmProcessamento, chaveTabela, StringComparison.OrdinalIgnoreCase);
        }

        private static string MFcn_MontarNomeArquivoBackup(int sequencia, string aliasBanco, string nomeTabela)
        {
            var nomeNormalizado = nomeTabela.ToUpperInvariant();
            return $"{sequencia:D5}_BKP_{aliasBanco}_{nomeNormalizado}.sql";
        }

        private static (string alias, string table)? MFcn_ExtrairBancoETabelaDeArquivoRestore(string filePath)
        {
            var fileName = Path.GetFileNameWithoutExtension(filePath);

            var matchBkp = Regex.Match(fileName, @"^\d+_BKP_([AB])_(.+)$", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
            if (matchBkp.Success)
            {
                return (matchBkp.Groups[1].Value.ToUpperInvariant(), matchBkp.Groups[2].Value);
            }

            var matchLegacy = Regex.Match(fileName, @"^([AB])_(.+)$", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
            if (matchLegacy.Success)
            {
                return (matchLegacy.Groups[1].Value.ToUpperInvariant(), matchLegacy.Groups[2].Value);
            }

            return null;
        }

        private static async Task<string> GetTableBackupSqlAsync(MySqlConnection connection, string table, CancellationToken cancellationToken)
        {
            var escapedTable = table.Replace("`", "``", StringComparison.Ordinal);
            var createStatement = await GetCreateTableSqlAsync(connection, table, cancellationToken);
            var dataStatements = await GetInsertDataSqlAsync(connection, table, cancellationToken);

            var scriptBuilder = new StringBuilder();
            scriptBuilder.AppendLine("SET FOREIGN_KEY_CHECKS=0;");
            scriptBuilder.AppendLine($"DROP TABLE IF EXISTS `{escapedTable}`;");
            scriptBuilder.AppendLine(createStatement + ";");
            scriptBuilder.AppendLine(dataStatements);
            scriptBuilder.AppendLine("SET FOREIGN_KEY_CHECKS=1;");
            return scriptBuilder.ToString();
        }

        private static async Task<string> GetCreateTableSqlAsync(MySqlConnection connection, string table, CancellationToken cancellationToken)
        {
            var escapedTable = table.Replace("`", "``", StringComparison.Ordinal);
            var commandText = $"SHOW CREATE TABLE `{escapedTable}`;";

            await using var command = new MySqlCommand(commandText, connection);
            await using var reader = await command.ExecuteReaderAsync(cancellationToken);
            if (!await reader.ReadAsync(cancellationToken))
            {
                throw new InvalidOperationException($"Não foi possível obter CREATE TABLE para '{table}'.");
            }

            return reader.GetString(1);
        }

        private static async Task<string> GetInsertDataSqlAsync(MySqlConnection connection, string table, CancellationToken cancellationToken)
        {
            var escapedTable = table.Replace("`", "``", StringComparison.Ordinal);
            var sql = $"SELECT * FROM `{escapedTable}`;";
            var scriptBuilder = new StringBuilder();

            await using var command = new MySqlCommand(sql, connection);
            await using var reader = await command.ExecuteReaderAsync(cancellationToken);

            if (reader.FieldCount == 0)
            {
                return string.Empty;
            }

            var columns = Enumerable.Range(0, reader.FieldCount)
                .Select(i => $"`{reader.GetName(i).Replace("`", "``", StringComparison.Ordinal)}`")
                .ToArray();

            var valueRows = new List<string>(200);
            while (await reader.ReadAsync(cancellationToken))
            {
                var values = new string[reader.FieldCount];
                for (var i = 0; i < reader.FieldCount; i++)
                {
                    values[i] = FormatSqlValue(reader.GetValue(i));
                }

                valueRows.Add($"({string.Join(",", values)})");

                if (valueRows.Count >= 200)
                {
                    AppendInsertBatch(scriptBuilder, escapedTable, columns, valueRows);
                    valueRows.Clear();
                }
            }

            if (valueRows.Count > 0)
            {
                AppendInsertBatch(scriptBuilder, escapedTable, columns, valueRows);
            }

            return scriptBuilder.ToString();
        }

        private static void AppendInsertBatch(StringBuilder scriptBuilder, string table, string[] columns, List<string> valueRows)
        {
            scriptBuilder.Append("INSERT INTO `");
            scriptBuilder.Append(table);
            scriptBuilder.Append("` (");
            scriptBuilder.Append(string.Join(",", columns));
            scriptBuilder.Append(") VALUES ");
            scriptBuilder.Append(string.Join(",", valueRows));
            scriptBuilder.AppendLine(";");
        }

        private static string FormatSqlValue(object? value)
        {
            if (value is null || value == DBNull.Value)
            {
                return "NULL";
            }

            return value switch
            {
                string s => $"'{EscapeSqlString(s)}'",
                char c => $"'{EscapeSqlString(c.ToString())}'",
                bool b => b ? "1" : "0",
                byte[] bytes => $"0x{Convert.ToHexString(bytes)}",
                DateTime dt => $"'{dt:yyyy-MM-dd HH:mm:ss.ffffff}'",
                DateTimeOffset dto => $"'{dto:yyyy-MM-dd HH:mm:ss.ffffff}'",
                TimeSpan ts => $"'{ts:c}'",
                sbyte or byte or short or ushort or int or uint or long or ulong => Convert.ToString(value, CultureInfo.InvariantCulture)!,
                float or double or decimal => Convert.ToString(value, CultureInfo.InvariantCulture)!,
                Guid g => $"'{g}'",
                _ => $"'{EscapeSqlString(Convert.ToString(value, CultureInfo.InvariantCulture) ?? string.Empty)}'",
            };
        }

        private static string EscapeSqlString(string value)
        {
            return value
                .Replace("\\", "\\\\", StringComparison.Ordinal)
                .Replace("'", "''", StringComparison.Ordinal);
        }

        private async Task<int> RestoreFilesAsync(DbTarget targetA, DbTarget targetB, IReadOnlyCollection<WMTbl_Tabela> tabelas, int processed, int total)
        {
            await using var connectionA = new MySqlConnection(BuildConnectionString(targetA));
            await using var connectionB = new MySqlConnection(BuildConnectionString(targetB));
            await connectionA.OpenAsync();
            await connectionB.OpenAsync();

            foreach (var tabela in tabelas.OrderBy(x => x.NomeFisico, StringComparer.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(tabela.ArquivoA))
                {
                    try
                    {
                        AddStatus(targetA.Alias, tabela.NomeFisico, "Restaurando", 0);
                        var scriptA = await File.ReadAllTextAsync(tabela.ArquivoA, Encoding.UTF8);
                        if (!string.IsNullOrWhiteSpace(scriptA))
                        {
                            await using var commandA = new MySqlCommand(scriptA, connectionA);
                            await commandA.ExecuteNonQueryAsync();
                        }

                        AddStatus(targetA.Alias, tabela.NomeFisico, "Concluído", 0);
                        processed++;
                        UpdateProgress(processed, total);
                    }
                    catch
                    {
                        AddStatus(targetA.Alias, tabela.NomeFisico, "Erro", 0);
                        throw;
                    }
                }

                if (!string.IsNullOrWhiteSpace(tabela.ArquivoB))
                {
                    try
                    {
                        AddStatus(targetB.Alias, tabela.NomeFisico, "Restaurando", 0);
                        var scriptB = await File.ReadAllTextAsync(tabela.ArquivoB, Encoding.UTF8);
                        if (!string.IsNullOrWhiteSpace(scriptB))
                        {
                            await using var commandB = new MySqlCommand(scriptB, connectionB);
                            await commandB.ExecuteNonQueryAsync();
                        }

                        AddStatus(targetB.Alias, tabela.NomeFisico, "Concluído", 0);
                        processed++;
                        UpdateProgress(processed, total);
                    }
                    catch
                    {
                        AddStatus(targetB.Alias, tabela.NomeFisico, "Erro", 0);
                        throw;
                    }
                }
            }

            return processed;
        }

