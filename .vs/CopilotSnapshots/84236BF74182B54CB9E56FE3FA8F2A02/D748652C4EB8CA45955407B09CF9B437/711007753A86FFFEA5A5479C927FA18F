                }

                list.Add(tabela);
            }

            return list;
        }

        private static string MFcn_NomeTabelaBase(string nomeTabelaFisica)
        {
            if (string.IsNullOrWhiteSpace(nomeTabelaFisica))
            {
                return string.Empty;
            }

            var match = Regex.Match(nomeTabelaFisica, @"^(.*)_([0-9]{4}|[0-9]{6})$", RegexOptions.CultureInvariant);
            if (!match.Success)
            {
                return nomeTabelaFisica;
            }

            return match.Groups[1].Value;
        }

        private List<string> MFcn_ObterModulosSelecionados()
        {
            var texto = txtEmpresa.Text.Trim();
            if (string.IsNullOrWhiteSpace(texto))
            {
                return new List<string>();
            }

            return texto
                .Split([' ', ',', ';', '\t', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        private static bool MFcn_TabelaAtendeFiltroModulo(WMTbl_Tabela tabela, IReadOnlyCollection<string> modulosSelecionados)
        {
            if (modulosSelecionados.Count == 0)
            {
                return true;
            }

            if (tabela.Metadata is null || string.IsNullOrWhiteSpace(tabela.Metadata.Modulo))
            {
                return true;
            }

            var modulosTabela = tabela.Metadata.Modulo
                .Split([' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            return modulosTabela.Any(x => modulosSelecionados.Contains(x, StringComparer.OrdinalIgnoreCase));
        }

        private KeyTabelaMetadata? MFcn_LocalizarMetadataTabela(string nomeTabelaFisica)
        {
            if (_wmMetadataKeyTabelas.TryGetValue(nomeTabelaFisica, out var metadataExata))
            {
                return metadataExata;
            }

            var nomeBase = MFcn_NomeTabelaBase(nomeTabelaFisica);
            if (!nomeBase.Equals(nomeTabelaFisica, StringComparison.OrdinalIgnoreCase)
                && _wmMetadataKeyTabelas.TryGetValue(nomeBase, out var metadataBase))
            {
                return metadataBase;
            }

            return null;
        }

        private async Task MPrc_CarregarMetadadosKeyTabelas(DbTarget targetA, DbTarget targetB)
        {
            _wmMetadataKeyTabelas.Clear();
            await MPrc_CarregarMetadadosKeyTabelasPorBanco(targetA);
            await MPrc_CarregarMetadadosKeyTabelasPorBanco(targetB);
        }

        private async Task MPrc_CarregarMetadadosKeyTabelasPorBanco(DbTarget target)
        {
            const string sql = @"
SELECT ktb_NomeFs, ktb_NomeLg, ktb_Modulo, ktb_TipoTb
FROM KEY_TABELAS;";

            try
            {
                await using var connection = new MySqlConnection(BuildConnectionString(target));
                await connection.OpenAsync();

                await using var command = new MySqlCommand(sql, connection);
                await using var reader = await command.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    var nomeFs = reader.IsDBNull(0) ? string.Empty : reader.GetString(0).Trim();
                    if (string.IsNullOrWhiteSpace(nomeFs))
                    {
                        continue;
                    }

                    if (_wmMetadataKeyTabelas.ContainsKey(nomeFs))
                    {
                        continue;
                    }

                    var nomeLg = reader.IsDBNull(1) ? string.Empty : reader.GetString(1).Trim();
                    var modulo = reader.IsDBNull(2) ? string.Empty : reader.GetString(2).Trim();
                    var tipoTb = reader.IsDBNull(3) ? string.Empty : reader.GetString(3).Trim();
                    _wmMetadataKeyTabelas[nomeFs] = new KeyTabelaMetadata(nomeFs, nomeLg, modulo, tipoTb);
                }
            }
            catch (Exception ex)
            {
                Log($"Aviso KEY_TABELAS ({target.Alias}): {ex.Message}");
            }
        }

        private void AddStatus(string alias, string table, string status, long rowCount)
