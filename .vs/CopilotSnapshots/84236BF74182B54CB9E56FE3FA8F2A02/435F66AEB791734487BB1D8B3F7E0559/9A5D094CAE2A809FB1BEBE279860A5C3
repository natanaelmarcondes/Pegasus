using MySqlConnector;
using System.Globalization;
using System.Text;

namespace Pegasus
{
    public partial class Form1 : Form
    {
        private sealed record DbTarget(string Alias, string Host, uint Port, string Database, string User, string Password);
        private sealed record TableInfo(string Name, long RowCount);

        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            txtBackupBasePath.Text = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory), "BackupsGDRW");
            Log("Preencha as conexões e clique em Carregar Tabelas.");
            UpdateProgress(0, 0);
        }

        private void Log(string message)
        {
            dgvStatus.Rows.Add("-", "Sistema", message, "");
        }

        private string BuildBackupDirectory()
        {
            var basePath = txtBackupBasePath.Text.Trim();
            var now = DateTime.Now;
            return Path.Combine(basePath, $"GDRW-{now:yyyyMMdd_HHmmss}");
        }

        private static string BuildConnectionString(DbTarget target)
        {
            var builder = new MySqlConnectionStringBuilder
            {
                Server = target.Host,
                Port = target.Port,
                Database = target.Database,
                UserID = target.User,
                Password = target.Password,
                ConnectionTimeout = 10,
                DefaultCommandTimeout = 120,
                AllowUserVariables = true,
                ConvertZeroDateTime = true,
                GuidFormat = MySqlGuidFormat.None,
            };

            return builder.ConnectionString;
        }

        private bool TryGetTargets(out DbTarget? targetA, out DbTarget? targetB)
        {
            targetA = null;
            targetB = null;

            var user = txtUser.Text.Trim();
            var password = txtPassword.Text;

            if (string.IsNullOrWhiteSpace(user))
            {
                MessageBox.Show("Informe o usuário.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            if (!TryCreateTarget("A", txtHostA.Text, txtPortA.Text, txtDatabaseA.Text, user, password, out targetA))
            {
                return false;
            }

            if (!TryCreateTarget("B", txtHostB.Text, txtPortB.Text, txtDatabaseB.Text, user, password, out targetB))
            {
                return false;
            }

            return true;
        }

        private static bool TryCreateTarget(string alias, string host, string portText, string database, string user, string password, out DbTarget? target)
        {
            target = null;

            if (string.IsNullOrWhiteSpace(host) || string.IsNullOrWhiteSpace(database))
            {
                MessageBox.Show($"Preencha host e database do banco {alias}.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            if (!uint.TryParse(portText.Trim(), out var port))
            {
                MessageBox.Show($"Porta inválida para banco {alias}.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            target = new DbTarget(alias, host.Trim(), port, database.Trim(), user, password);
            return true;
        }

        private void SetBusy(bool busy)
        {
            UseWaitCursor = busy;
            btnLoadTables.Enabled = !busy;
            btnBackup.Enabled = !busy;
            btnRestore.Enabled = !busy;
            btnChooseBackupFolder.Enabled = !busy;
            btnSelectAllA.Enabled = !busy;
            btnSelectAllB.Enabled = !busy;
            btnUnselectAllA.Enabled = !busy;
            btnUnselectAllB.Enabled = !busy;
        }

        private void btnChooseBackupFolder_Click(object sender, EventArgs e)
        {
            folderBrowserDialog.SelectedPath = txtBackupBasePath.Text;
            if (folderBrowserDialog.ShowDialog(this) == DialogResult.OK)
            {
                txtBackupBasePath.Text = folderBrowserDialog.SelectedPath;
            }
        }

        private void btnSelectAllA_Click(object sender, EventArgs e) => SetAllRowsByAlias("A", true);
        private void btnUnselectAllA_Click(object sender, EventArgs e) => SetAllRowsByAlias("A", false);
        private void btnSelectAllB_Click(object sender, EventArgs e) => SetAllRowsByAlias("B", true);
        private void btnUnselectAllB_Click(object sender, EventArgs e) => SetAllRowsByAlias("B", false);

        private void SetAllRowsByAlias(string alias, bool selected)
        {
            var grid = alias == "A" ? dgvTablesA : dgvTablesB;
            var checkColumn = alias == "A" ? "colSelA" : "colSelB";
            foreach (DataGridViewRow row in grid.Rows)
            {
                row.Cells[checkColumn].Value = selected;
            }
        }

        private List<TableInfo> GetSelectedTables(string alias)
        {
            var list = new List<TableInfo>();
            var grid = alias == "A" ? dgvTablesA : dgvTablesB;
            var checkColumn = alias == "A" ? "colSelA" : "colSelB";
            var tableColumn = alias == "A" ? "colTabelaA" : "colTabelaB";
            var qtyColumn = alias == "A" ? "colQtdA" : "colQtdB";

            foreach (DataGridViewRow row in grid.Rows)
            {
                var isChecked = row.Cells[checkColumn].Value as bool? == true;
                if (!isChecked)
                {
                    continue;
                }

                var tableName = Convert.ToString(row.Cells[tableColumn].Value) ?? string.Empty;
                if (string.IsNullOrWhiteSpace(tableName))
                {
                    continue;
                }

                var rowCountText = Convert.ToString(row.Cells[qtyColumn].Value) ?? "0";
                _ = long.TryParse(rowCountText, out var rowCount);
                list.Add(new TableInfo(tableName, rowCount));
            }

            return list;
        }

        private void AddStatus(string alias, string table, string status, long rowCount)
        {
            dgvStatus.Rows.Add(alias, table, status, rowCount.ToString("N0"));
        }

        private void UpdateProgress(int processed, int total)
        {
            progressMain.Maximum = Math.Max(1, total);
            progressMain.Value = Math.Min(processed, progressMain.Maximum);
            var pct = total == 0 ? 0 : (int)Math.Round((double)processed / total * 100, MidpointRounding.AwayFromZero);
            lblProgress.Text = $"Progresso: {processed} de {total} ({pct}%)";
        }

        private void dgvStatus_CellPainting(object sender, DataGridViewCellPaintingEventArgs e)
        {
            if (e.RowIndex < 0 || e.ColumnIndex != colStatusProgresso.Index)
            {
                return;
            }
        }

        private async void btnLoadTables_Click(object sender, EventArgs e)
        {
            if (!TryGetTargets(out var targetA, out var targetB))
            {
                return;
            }

            try
            {
                SetBusy(true);
                dgvStatus.Rows.Clear();
                Log("Carregando tabelas dos bancos A e B...");

                var taskA = LoadTablesAsync(targetA!);
                var taskB = LoadTablesAsync(targetB!);
                await Task.WhenAll(taskA, taskB);

                FillTableGrid(dgvTablesA, taskA.Result, "colSelA", "colTabelaA", "colQtdA");
                FillTableGrid(dgvTablesB, taskB.Result, "colSelB", "colTabelaB", "colQtdB");

                Log($"Tabelas carregadas. A:{taskA.Result.Count} B:{taskB.Result.Count}");
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Falha ao carregar tabelas: {ex.Message}", "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
                Log($"Erro: {ex.Message}");
            }
            finally
            {
                SetBusy(false);
            }
        }

        private static void FillTableGrid(DataGridView grid, IReadOnlyCollection<TableInfo> tables, string selCol, string tableCol, string qtyCol)
        {
            grid.Rows.Clear();
            foreach (var table in tables)
            {
                var idx = grid.Rows.Add();
                grid.Rows[idx].Cells[selCol].Value = true;
                grid.Rows[idx].Cells[tableCol].Value = table.Name;
                grid.Rows[idx].Cells[qtyCol].Value = table.RowCount.ToString("N0");
            }
        }

        private async void btnBackup_Click(object sender, EventArgs e)
        {
            if (!TryGetTargets(out var targetA, out var targetB))
            {
                return;
            }

            var selectedA = GetSelectedTables("A");
            var selectedB = GetSelectedTables("B");
            var totalTables = selectedA.Count + selectedB.Count;

            if (totalTables == 0)
            {
                MessageBox.Show("Selecione ao menos uma tabela para backup.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(txtBackupBasePath.Text))
            {
                MessageBox.Show("Informe a pasta de backup.", "Validação", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                SetBusy(true);
                dgvStatus.Rows.Clear();
                UpdateProgress(0, totalTables);

                var backupDirectory = BuildBackupDirectory();
                Directory.CreateDirectory(backupDirectory);
                Log($"Backup em: {backupDirectory}");

                var processed = 0;
                if (selectedA.Count > 0)
                {
                    processed = await BackupTablesAsync(targetA!, selectedA, backupDirectory, processed, totalTables);
                }

                if (selectedB.Count > 0)
                {
                    processed = await BackupTablesAsync(targetB!, selectedB, backupDirectory, processed, totalTables);
                }

                UpdateProgress(processed, totalTables);
                MessageBox.Show("Backup concluído.", "Sucesso", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Falha no backup: {ex.Message}", "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
                Log($"Erro no backup: {ex.Message}");
            }
            finally
            {
                SetBusy(false);
            }
        }

        private async void btnRestore_Click(object sender, EventArgs e)
        {
            if (!TryGetTargets(out var targetA, out var targetB))
            {
                return;
            }

            folderBrowserDialog.SelectedPath = txtBackupBasePath.Text;
            if (folderBrowserDialog.ShowDialog(this) != DialogResult.OK)
            {
                return;
            }

            var restorePath = folderBrowserDialog.SelectedPath;
            var sqlFiles = Directory.GetFiles(restorePath, "*.sql", SearchOption.TopDirectoryOnly);
            if (sqlFiles.Length == 0)
            {
                MessageBox.Show("Nenhum arquivo .sql encontrado na pasta selecionada.", "Restore", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var filesA = sqlFiles.Where(x => Path.GetFileName(x).StartsWith("A_", StringComparison.OrdinalIgnoreCase)).ToList();
            var filesB = sqlFiles.Where(x => Path.GetFileName(x).StartsWith("B_", StringComparison.OrdinalIgnoreCase)).ToList();
            var totalFiles = filesA.Count + filesB.Count;
            var ignoredFiles = sqlFiles.Length - totalFiles;

            try
            {
                SetBusy(true);
                dgvStatus.Rows.Clear();
                UpdateProgress(0, totalFiles);

                var processed = 0;
                if (filesA.Count > 0)
                {
                    processed = await RestoreFilesAsync(targetA!, filesA, processed, totalFiles);
                }

                if (filesB.Count > 0)
                {
                    processed = await RestoreFilesAsync(targetB!, filesB, processed, totalFiles);
                }

                if (ignoredFiles > 0)
                {
                    Log($"{ignoredFiles} arquivo(s) ignorado(s) sem prefixo A_ ou B_.");
                }

                UpdateProgress(processed, totalFiles);
                MessageBox.Show("Restore concluído.", "Sucesso", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Falha no restore: {ex.Message}", "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
                Log($"Erro no restore: {ex.Message}");
            }
            finally
            {
                SetBusy(false);
            }
        }

        private async Task<List<TableInfo>> LoadTablesAsync(DbTarget target)
        {
            const string query = @"
SELECT TABLE_NAME, COALESCE(TABLE_ROWS, 0) AS TABLE_ROWS
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = @db
  AND TABLE_TYPE = 'BASE TABLE'
ORDER BY TABLE_NAME;";

            var tables = new List<TableInfo>();

            await using var connection = new MySqlConnection(BuildConnectionString(target));
            await connection.OpenAsync();

            await using var command = new MySqlCommand(query, connection);
            command.Parameters.AddWithValue("@db", target.Database);

            await using var reader = await command.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                var name = reader.GetString(0);
                var rows = Convert.ToInt64(reader.GetValue(1), CultureInfo.InvariantCulture);
                tables.Add(new TableInfo(name, rows));
            }

            return tables;
        }

        private async Task<int> BackupTablesAsync(DbTarget target, IReadOnlyCollection<TableInfo> tables, string backupDirectory, int processed, int total)
        {
            await using var connection = new MySqlConnection(BuildConnectionString(target));
            await connection.OpenAsync();

            foreach (var table in tables)
            {
                AddStatus(target.Alias, table.Name, "Processando", table.RowCount);

                var createAndDataSql = await GetTableBackupSqlAsync(connection, table.Name);
                var fileName = $"{target.Alias}_{table.Name}.sql";
                var filePath = Path.Combine(backupDirectory, fileName);
                await File.WriteAllTextAsync(filePath, createAndDataSql, Encoding.UTF8);

                AddStatus(target.Alias, table.Name, "Concluído", table.RowCount);
                processed++;
                UpdateProgress(processed, total);
            }

            return processed;
        }

        private static async Task<string> GetTableBackupSqlAsync(MySqlConnection connection, string table)
        {
            var escapedTable = table.Replace("`", "``", StringComparison.Ordinal);
            var createStatement = await GetCreateTableSqlAsync(connection, table);
            var dataStatements = await GetInsertDataSqlAsync(connection, table);

            var scriptBuilder = new StringBuilder();
            scriptBuilder.AppendLine("SET FOREIGN_KEY_CHECKS=0;");
            scriptBuilder.AppendLine($"DROP TABLE IF EXISTS `{escapedTable}`;");
            scriptBuilder.AppendLine(createStatement + ";");
            scriptBuilder.AppendLine(dataStatements);
            scriptBuilder.AppendLine("SET FOREIGN_KEY_CHECKS=1;");
            return scriptBuilder.ToString();
        }

        private static async Task<string> GetCreateTableSqlAsync(MySqlConnection connection, string table)
        {
            var escapedTable = table.Replace("`", "``", StringComparison.Ordinal);
            var commandText = $"SHOW CREATE TABLE `{escapedTable}`;";

            await using var command = new MySqlCommand(commandText, connection);
            await using var reader = await command.ExecuteReaderAsync();
            if (!await reader.ReadAsync())
            {
                throw new InvalidOperationException($"Não foi possível obter CREATE TABLE para '{table}'.");
            }

            return reader.GetString(1);
        }

        private static async Task<string> GetInsertDataSqlAsync(MySqlConnection connection, string table)
        {
            var escapedTable = table.Replace("`", "``", StringComparison.Ordinal);
            var sql = $"SELECT * FROM `{escapedTable}`;";
            var scriptBuilder = new StringBuilder();

            await using var command = new MySqlCommand(sql, connection);
            await using var reader = await command.ExecuteReaderAsync();

            if (reader.FieldCount == 0)
            {
                return string.Empty;
            }

            var columns = Enumerable.Range(0, reader.FieldCount)
                .Select(i => $"`{reader.GetName(i).Replace("`", "``", StringComparison.Ordinal)}`")
                .ToArray();

            var valueRows = new List<string>(200);
            while (await reader.ReadAsync())
            {
                var values = new string[reader.FieldCount];
                for (var i = 0; i < reader.FieldCount; i++)
                {
                    values[i] = FormatSqlValue(reader.GetValue(i));
                }

                valueRows.Add($"({string.Join(",", values)})");

                if (valueRows.Count >= 200)
                {
                    AppendInsertBatch(scriptBuilder, escapedTable, columns, valueRows);
                    valueRows.Clear();
                }
            }

            if (valueRows.Count > 0)
            {
                AppendInsertBatch(scriptBuilder, escapedTable, columns, valueRows);
            }

            return scriptBuilder.ToString();
        }

        private static void AppendInsertBatch(StringBuilder scriptBuilder, string table, string[] columns, List<string> valueRows)
        {
            scriptBuilder.Append("INSERT INTO `");
            scriptBuilder.Append(table);
            scriptBuilder.Append("` (");
            scriptBuilder.Append(string.Join(",", columns));
            scriptBuilder.Append(") VALUES ");
            scriptBuilder.Append(string.Join(",", valueRows));
            scriptBuilder.AppendLine(";");
        }

        private static string FormatSqlValue(object? value)
        {
            if (value is null || value == DBNull.Value)
            {
                return "NULL";
            }

            return value switch
            {
                string s => $"'{EscapeSqlString(s)}'",
                char c => $"'{EscapeSqlString(c.ToString())}'",
                bool b => b ? "1" : "0",
                byte[] bytes => $"0x{Convert.ToHexString(bytes)}",
                DateTime dt => $"'{dt:yyyy-MM-dd HH:mm:ss.ffffff}'",
                DateTimeOffset dto => $"'{dto:yyyy-MM-dd HH:mm:ss.ffffff}'",
                TimeSpan ts => $"'{ts:c}'",
                sbyte or byte or short or ushort or int or uint or long or ulong => Convert.ToString(value, CultureInfo.InvariantCulture)!,
                float or double or decimal => Convert.ToString(value, CultureInfo.InvariantCulture)!,
                Guid g => $"'{g}'",
                _ => $"'{EscapeSqlString(Convert.ToString(value, CultureInfo.InvariantCulture) ?? string.Empty)}'",
            };
        }

        private static string EscapeSqlString(string value)
        {
            return value
                .Replace("\\", "\\\\", StringComparison.Ordinal)
                .Replace("'", "''", StringComparison.Ordinal);
        }

        private async Task<int> RestoreFilesAsync(DbTarget target, IReadOnlyCollection<string> sqlFiles, int processed, int total)
        {
            await using var connection = new MySqlConnection(BuildConnectionString(target));
            await connection.OpenAsync();

            foreach (var file in sqlFiles.OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
            {
                var fileNameNoExt = Path.GetFileNameWithoutExtension(file);
                var tableName = fileNameNoExt.Length > 2 ? fileNameNoExt[2..] : "tabela";
                AddStatus(target.Alias, tableName, "Restaurando", 0);

                var script = await File.ReadAllTextAsync(file, Encoding.UTF8);
                if (!string.IsNullOrWhiteSpace(script))
                {
                    await using var command = new MySqlCommand(script, connection);
                    await command.ExecuteNonQueryAsync();
                }

                AddStatus(target.Alias, tableName, "Concluído", 0);
                processed++;
                UpdateProgress(processed, total);
            }

            return processed;
        }
    }
